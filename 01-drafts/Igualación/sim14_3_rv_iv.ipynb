   "source": [
    "# ═══════════════════════════════════════════════════════════════════════════\n",
    "# CONTROLES INTERACTIVOS\n",
    "# ═══════════════════════════════════════════════════════════════════════════\n",
    "\n",
    "display(HTML(\"<hr style='border:none; border-top:1px solid #E2E8F0; margin:18px 0 14px;'>\"))\n",
    "\n",
    "S = {'description_width': '135px'}\n",
    "L = widgets.Layout(width='420px')\n",
    "\n",
    "w_nrv = widgets.IntSlider(\n",
    "    value=10, min=3, max=30, step=1,\n",
    "    description='RV (razón media n):',\n",
    "    style=S, layout=L,\n",
    "    tooltip='Número de respuestas por refuerzo en el programa de razón variable')\n",
    "\n",
    "w_tiv = widgets.IntSlider(\n",
    "    value=30, min=10, max=120, step=5,\n",
    "    description='IV (intervalo, resp.):',\n",
    "    style=S, layout=L,\n",
    "    tooltip='Intervalo medio del programa de intervalo variable, en respuestas (30 resp ≈ 1 min a 30 resp/min)')\n",
    "\n",
    "w_ntr = widgets.IntSlider(\n",
    "    value=1800, min=600, max=4000, step=200,\n",
    "    description='Total respuestas:',\n",
    "    style=S, layout=L,\n",
    "    tooltip='Duración de la sesión en respuestas (1800 ≈ 60 min a 30 resp/min)')\n",
    "\n",
    "w_alp = widgets.FloatSlider(\n",
    "    value=0.12, min=0.02, max=0.30, step=0.02,\n",
    "    description='α (melioration):',\n",
    "    style=S, layout=L,\n",
    "    readout_format='.2f',\n",
    "    tooltip='Tasa de ajuste del organismo de igualación. Valores altos: convergencia rápida pero oscilatoria')\n",
    "\n",
    "row1 = widgets.HBox([w_nrv, w_tiv])\n",
    "row2 = widgets.HBox([w_ntr, w_alp])\n",
    "\n",
    "# Nota informativa sobre el equilibrio teórico\n",
    "info_out = widgets.Output()\n",
    "\n",
    "def actualizar_info(change=None):\n",
    "    f_iv = w_nrv.value / w_tiv.value\n",
    "    p_rv = 1 - f_iv\n",
    "    with info_out:\n",
    "        info_out.clear_output(wait=True)\n",
    "        display(HTML(\n",
    "            f'<p style=\"font-family:monospace; font-size:0.90em; color:#2D3748; '\n",
    "            f'background:#F0FFF4; border-left:3px solid #276749; '\n",
    "            f'padding:8px 12px; margin:6px 0;\">'\n",
    "            f'Equilibrio teórico de igualación: '\n",
    "            f'f<sub>IV</sub> = {w_nrv.value}/{w_tiv.value} = {f_iv:.3f} &nbsp;→&nbsp; '\n",
    "            f'RV {p_rv:.0%} / IV {f_iv:.0%}'\n",
    "            f'</p>'\n",
    "        ))\n",
    "\n",
    "w_nrv.observe(actualizar_info, names='value')\n",
    "w_tiv.observe(actualizar_info, names='value')\n",
    "actualizar_info()\n",
    "\n",
    "btn = widgets.Button(\n",
    "    description='▶  Correr simulación',\n",
    "    button_style='primary',\n",
    "    layout=widgets.Layout(width='200px', height='38px'))\n",
    "\n",
    "out = widgets.Output()\n",
    "\n",
    "display(row1, row2, info_out, btn, out)\n",
    "\n",
    "\n",
    "def al_hacer_clic(b):\n",
    "    out.clear_output(wait=True)\n",
    "    with out:\n",
    "        res = simular(\n",
    "            n_ensayos=w_ntr.value,\n",
    "            n_rv=w_nrv.value,\n",
    "            t_iv=w_tiv.value,\n",
    "            alpha_mel=w_alp.value,\n",
    "        )\n",
    "        graficar(res)\n",
    "\n",
    "\n",
    "btn.on_click(al_hacer_clic)\n",
    "\n",
    "# Ejecución inmediata con parámetros por defecto\n",
    "with out:\n",
    "    res0 = simular(n_ensayos=1800, n_rv=10, t_iv=30, alpha_mel=0.12)\n",
    "    graficar(res0)"
   ]
  },
