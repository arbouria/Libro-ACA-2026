    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.ticker as mticker\n",
    "from IPython.display import display, HTML\n",
    "import ipywidgets as widgets\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# ── Paleta del libro ───────────────────────────────────────────────────────\n",
    "AZUL    = '#2C5282'\n",
    "NARANJA = '#C05621'\n",
    "VERDE   = '#276749'\n",
    "GRIS    = '#718096'\n",
    "FONDO   = '#F7FAFC'\n",
    "\n",
    "# ── Panel de presentación ─────────────────────────────────────────────────\n",
    "display(HTML(\"\"\"\n",
    "<div style=\"background:#EBF4FF; border-left:5px solid #2C5282; padding:20px 24px;\n",
    "            margin-bottom:20px; font-family:Georgia,Palatino,serif;\n",
    "            border-radius:0 4px 4px 0;\n",
    "            border-top:1px solid #BEE3F8; border-bottom:1px solid #BEE3F8;\n",
    "            border-right:1px solid #BEE3F8;\">\n",
    "  <h3 style=\"color:#2C5282; margin:0 0 10px 0; font-size:1.1em; letter-spacing:0.02em;\">\n",
    "    Simulador 14.3 &mdash; Programas Concurrentes RV-IV:\n",
    "    &#191;Rentabilidad o Maximización?\n",
    "  </h3>\n",
    "  <p style=\"margin:0 0 9px 0; color:#2D3748; font-size:0.95em; line-height:1.65;\">\n",
    "    Dos organismos compiten en el mismo programa concurrente\n",
    "    <strong>razón variable (RV) &mdash; intervalo variable (IV)</strong>.\n",
    "    El <strong style=\"color:#2C5282;\">organismo de rentabilidad</strong>\n",
    "    aplica el algoritmo de mejoramiento (<em>melioration</em>): después de cada bloque\n",
    "    de respuestas, compara las tasas locales de refuerzo de ambas opciones y desplaza\n",
    "    su comportamiento hacia la más rentable. Converge al equilibrio donde las\n",
    "    rentabilidades se igualan.\n",
    "  </p>\n",
    "  <p style=\"margin:0 0 9px 0; color:#2D3748; font-size:0.95em; line-height:1.65;\">\n",
    "    El <strong style=\"color:#C05621;\">organismo de maximización</strong>\n",
    "    aplica ascenso de colina sobre el <em>total</em> de refuerzos: en cada bloque,\n",
    "    incrementa la fracción dedicada al RV porque eso aumenta la ganancia global\n",
    "    (los refuerzos del IV son cosechables con visitas breves, independientemente\n",
    "    del tiempo total invertido).\n",
    "  </p>\n",
    "  <p style=\"margin:0; color:#2D3748; font-size:0.95em; line-height:1.65;\">\n",
    "    <strong>Panel 1:</strong> distribución de respuestas.\n",
    "    <strong>Panel 2:</strong> rentabilidades locales del organismo de igualación.\n",
    "    <strong>Panel 3:</strong> refuerzos acumulados y <em>costo de igualar</em>.\n",
    "  </p>\n",
    "</div>\n",
    "\"\"\"))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ═══════════════════════════════════════════════════════════════════════════\n",
    "# SIMULACIÓN\n",
    "# ═══════════════════════════════════════════════════════════════════════════\n",
    "\n",
    "def simular(n_ensayos, n_rv, t_iv, alpha_mel=0.12, alpha_max=0.025,\n",
    "            batch=50, seed=42):\n",
    "    \"\"\"\n",
    "    Simula dos organismos en un programa concurrente RV-IV.\n",
    "\n",
    "    Modelo del IV: acumulación libre.\n",
    "        - vi_acc crece en 1/t_iv por ensayo, independientemente de las elecciones.\n",
    "        - Cuando el organismo responde en IV:\n",
    "              P(refuerzo) = min(vi_acc, 1.0)   y   vi_acc ← 0.\n",
    "        - Esto garantiza que el total de refuerzos del IV ≈ n_ensayos/t_iv,\n",
    "          constante para cualquier distribución f_iv > 1/t_iv.\n",
    "\n",
    "    Organismo 1 — Rentabilidad (melioration):\n",
    "        Cada `batch` respuestas compara tasa_local_RV vs tasa_local_IV y\n",
    "        ajusta p_rv += alpha_mel * (tasa_RV - tasa_IV).\n",
    "        Equilibrio teórico: p_rv_eq = 1 - n_rv/t_iv.\n",
    "\n",
    "    Organismo 2 — Maximización (ascenso de colina sobre total):\n",
    "        Cada `batch` incrementa p_rv en alpha_max.\n",
    "        Justificado porque d(total)/d(p_rv) = 1/n_rv > 0 siempre.\n",
    "        Converge a p_rv ≈ 0.95.\n",
    "    \"\"\"\n",
    "    rng  = np.random.default_rng(seed)\n",
    "    fill = 1.0 / t_iv\n",
    "\n",
    "    # ── Estado: organismo 1 (rentabilidad) ───────────────────────────────\n",
    "    p1      = 0.5\n",
    "    vi_acc1 = 0.0\n",
    "    rv_r1 = rv_n1 = vi_r1 = vi_n1 = 0   # contadores de bloque\n",
    "    _lr_rv  = 1.0 / n_rv                  # estimado corriente de tasa local\n",
    "    _lr_iv  = 1.0 / n_rv\n",
    "\n",
    "    # ── Estado: organismo 2 (maximización) ───────────────────────────────\n",
    "    p2      = 0.5\n",
    "    vi_acc2 = 0.0\n",
    "\n",
    "    # ── Almacenamiento ────────────────────────────────────────────────────\n",
    "    p1_h   = np.zeros(n_ensayos)\n",
    "    p2_h   = np.zeros(n_ensayos)\n",
    "    lrv_h  = np.full(n_ensayos, 1.0 / n_rv)   # tasa local RV (org. 1)\n",
    "    lri_h  = np.full(n_ensayos, 1.0 / n_rv)   # tasa local IV (org. 1)\n",
    "    cum1   = np.zeros(n_ensayos)\n",
    "    cum2   = np.zeros(n_ensayos)\n",
    "    tot1   = tot2 = 0\n",
    "\n",
    "    for t in range(n_ensayos):\n",
    "        # Acumuladores IV crecen cada ensayo (acumulación libre, tope en 3)\n",
    "        vi_acc1 = min(vi_acc1 + fill, 3.0)\n",
    "        vi_acc2 = min(vi_acc2 + fill, 3.0)\n",
    "\n",
    "        # ── Organismo 1 ──────────────────────────────────────────────────\n",
    "        c1 = 0 if rng.random() < p1 else 1\n",
    "        r1 = 0\n",
    "        if c1 == 0:            # respuesta RV\n",
    "            rv_n1 += 1\n",
    "            if rng.random() < 1.0 / n_rv:\n",
    "                r1 = 1;  rv_r1 += 1\n",
    "        else:                  # respuesta IV\n",
    "            vi_n1 += 1\n",
    "            if rng.random() < min(vi_acc1, 1.0):\n",
    "                r1 = 1;  vi_r1 += 1\n",
    "            vi_acc1 = 0.0      # siempre reinicia el acumulador\n",
    "\n",
    "        tot1 += r1;  cum1[t] = tot1\n",
    "        p1_h[t]  = p1\n",
    "        lrv_h[t] = _lr_rv\n",
    "        lri_h[t] = _lr_iv\n",
    "\n",
    "        # Actualización de melioration al final de cada bloque\n",
    "        if (t + 1) % batch == 0:\n",
    "            if rv_n1 >= 5 and vi_n1 >= 5:\n",
    "                _lr_rv = rv_r1 / rv_n1\n",
    "                _lr_iv = vi_r1 / vi_n1\n",
    "                p1 = float(np.clip(\n",
    "                    p1 + alpha_mel * (_lr_rv - _lr_iv), 0.05, 0.95))\n",
    "            rv_r1 = rv_n1 = vi_r1 = vi_n1 = 0\n",
    "\n",
    "        # ── Organismo 2 ──────────────────────────────────────────────────\n",
    "        c2 = 0 if rng.random() < p2 else 1\n",
    "        r2 = 0\n",
    "        if c2 == 0:\n",
    "            if rng.random() < 1.0 / n_rv:\n",
    "                r2 = 1\n",
    "        else:\n",
    "            if rng.random() < min(vi_acc2, 1.0):\n",
    "                r2 = 1\n",
    "            vi_acc2 = 0.0\n",
    "\n",
    "        tot2 += r2;  cum2[t] = tot2\n",
    "        p2_h[t] = p2\n",
    "\n",
    "        # El maximizador siempre incrementa p_rv (gradiente positivo)\n",
    "        if (t + 1) % batch == 0:\n",
    "            p2 = float(np.clip(p2 + alpha_max, 0.05, 0.97))\n",
    "\n",
    "    # ── Suavizado con ventana deslizante ─────────────────────────────────\n",
    "    def smooth(arr, w):\n",
    "        cs = np.cumsum(arr)\n",
    "        cs[w:] = cs[w:] - cs[:-w]\n",
    "        return cs / np.minimum(np.arange(1, len(arr) + 1), w)\n",
    "\n",
    "    # Equilibrio teórico de igualación\n",
    "    f_iv_eq  = float(np.clip(n_rv / t_iv, 0.05, 0.95))\n",
    "    p_rv_eq  = 1.0 - f_iv_eq\n",
    "\n",
    "    return {\n",
    "        'p1'      : smooth(p1_h,  250),\n",
    "        'p2'      : smooth(p2_h,  250),\n",
    "        'lr_rv'   : smooth(lrv_h, 400),\n",
    "        'lr_iv'   : smooth(lri_h, 400),\n",
    "        'cum1'    : cum1,\n",
    "        'cum2'    : cum2,\n",
    "        'p_rv_eq' : p_rv_eq,\n",
    "        'final_p1': float(np.mean(p1_h[-300:])),\n",
    "        'final_p2': float(np.mean(p2_h[-300:])),\n",
    "        'total1'  : tot1,\n",
    "        'total2'  : tot2,\n",
    "        'n_rv'    : n_rv,\n",
    "        't_iv'    : t_iv,\n",
    "        'n'       : n_ensayos,\n",
    "    }"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ═══════════════════════════════════════════════════════════════════════════\n",
    "# VISUALIZACIÓN\n",
    "# ═══════════════════════════════════════════════════════════════════════════\n",
    "\n",
    "def graficar(res):\n",
    "    n   = res['n']\n",
    "    x   = np.arange(n)\n",
    "    eq  = res['p_rv_eq']\n",
    "    n_rv = res['n_rv'];  t_iv = res['t_iv']\n",
    "\n",
    "    fig, axes = plt.subplots(3, 1, figsize=(12, 11))\n",
    "    fig.patch.set_facecolor('white')\n",
    "    fig.subplots_adjust(hspace=0.50, left=0.09, right=0.97,\n",
    "                        top=0.92, bottom=0.06)\n",
    "\n",
    "    # ── Panel 1: Distribución de respuestas ──────────────────────────────\n",
    "    ax = axes[0]\n",
    "    ax.plot(x, res['p2'], color=NARANJA, lw=1.9, alpha=0.92,\n",
    "            label=f\"Maximización  (RV final: {res['final_p2']:.0%})\")\n",
    "    ax.plot(x, res['p1'], color=AZUL,    lw=1.9, alpha=0.92,\n",
    "            label=f\"Rentabilidad  (RV final: {res['final_p1']:.0%})\")\n",
    "    ax.axhline(eq, color=AZUL, lw=1.1, ls='--', alpha=0.45,\n",
    "               label=f'Equilibrio teórico igualación: RV {eq:.0%}')\n",
    "    ax.set_ylim(0.30, 1.02)\n",
    "    ax.yaxis.set_major_formatter(mticker.PercentFormatter(1.0, decimals=0))\n",
    "    ax.set_xlabel('Respuesta', fontsize=10)\n",
    "    ax.set_ylabel('% respuestas en RV', fontsize=10)\n",
    "    ax.set_title('Distribución de Respuestas a lo Largo de la Sesión',\n",
    "                 fontsize=11, fontweight='bold', color='#2D3748', pad=7)\n",
    "    ax.legend(fontsize=9, loc='lower right', framealpha=0.93)\n",
    "    ax.set_facecolor(FONDO);  ax.grid(True, alpha=0.25)\n",
    "\n",
    "    # Banda sombreada alrededor del equilibrio observado de igualación\n",
    "    fp1 = res['final_p1']\n",
    "    ax.axhspan(fp1 - 0.03, fp1 + 0.03, color=AZUL, alpha=0.07, zorder=0)\n",
    "\n",
    "    # ── Panel 2: Rentabilidades locales (org. 1) ─────────────────────────\n",
    "    ax = axes[1]\n",
    "    start = 300\n",
    "    ax.plot(x[start:], res['lr_rv'][start:], color=AZUL,  lw=1.9,\n",
    "            label='Rentabilidad local RV')\n",
    "    ax.plot(x[start:], res['lr_iv'][start:], color=VERDE, lw=1.9,\n",
    "            label='Rentabilidad local IV')\n",
    "    ax.axhline(1.0 / n_rv, color=GRIS, lw=1.0, ls=':', alpha=0.65,\n",
    "               label=f'Valor teórico en equilibrio: 1/{n_rv} = {1/n_rv:.3f}')\n",
    "    y_top = min(1.0 / n_rv * 3.5, 1.05)\n",
    "    ax.set_ylim(0, y_top)\n",
    "    ax.yaxis.set_major_formatter(mticker.FormatStrFormatter('%.3f'))\n",
    "    ax.set_xlabel('Respuesta', fontsize=10)\n",
    "    ax.set_ylabel('Refuerzos / respuesta', fontsize=10)\n",
    "    ax.set_title('Rentabilidades Locales — Organismo de Igualación',\n",
    "                 fontsize=11, fontweight='bold', color='#2D3748', pad=7)\n",
    "    ax.legend(fontsize=9, framealpha=0.93)\n",
    "    ax.set_facecolor(FONDO);  ax.grid(True, alpha=0.25)\n",
    "\n",
    "    # ── Panel 3: Refuerzos acumulados ────────────────────────────────────\n",
    "    ax = axes[2]\n",
    "    ax.plot(x, res['cum2'], color=NARANJA, lw=1.9, alpha=0.92,\n",
    "            label=f\"Maximización  (total: {res['total2']:,})\")\n",
    "    ax.plot(x, res['cum1'], color=AZUL,    lw=1.9, alpha=0.92,\n",
    "            label=f\"Rentabilidad  (total: {res['total1']:,})\")\n",
    "    ax.fill_between(x, res['cum1'], res['cum2'],\n",
    "                    where=(res['cum2'] >= res['cum1']),\n",
    "                    color=NARANJA, alpha=0.12, zorder=0)\n",
    "\n",
    "    costo = res['total2'] - res['total1']\n",
    "    pct   = 100.0 * costo / max(res['total2'], 1)\n",
    "    ax.text(0.97, 0.09,\n",
    "            f'Costo de igualar: {costo:+d} refuerzos ({pct:.0f}%)',\n",
    "            transform=ax.transAxes, ha='right', va='bottom',\n",
    "            fontsize=9.5, color='#7B341E',\n",
    "            bbox=dict(boxstyle='round,pad=0.45', facecolor='#FFFAF0',\n",
    "                      edgecolor='#C05621', alpha=0.92))\n",
    "    ax.set_xlabel('Respuesta', fontsize=10)\n",
    "    ax.set_ylabel('Refuerzos acumulados', fontsize=10)\n",
    "    ax.set_title('Refuerzos Acumulados en la Sesión',\n",
    "                 fontsize=11, fontweight='bold', color='#2D3748', pad=7)\n",
    "    ax.legend(fontsize=9, loc='upper left', framealpha=0.93)\n",
    "    ax.set_facecolor(FONDO);  ax.grid(True, alpha=0.25)\n",
    "\n",
    "    fig.suptitle(\n",
    "        f'RV {n_rv} — IV {t_iv} resp. media  |  '\n",
    "        f'Sesión: {n:,} respuestas  |  '\n",
    "        f'Equilibrio igualación: RV {eq:.0%} / IV {1-eq:.0%}',\n",
    "        fontsize=10.5, color='#2D3748', fontweight='bold', y=0.975\n",
    "    )\n",
    "    plt.show()"
   ]
  },
